# Copy to .env and fill in. Never commit .env. Never prefix secrets with VITE_ (Vite ships those to the browser).

# Google Earth Engine (worker)
GEE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gee-service-account.json

# Provider keys (worker)
FIRMS_MAP_KEY=
CIMIS_APP_KEY=
AIRNOW_API_KEY=

# Agent LLM via OpenRouter (free models): your own key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# optional: comma-separated model list, tried in order (defaults live in apps/worker/src/inland_worker/agent/llm.py)
AGENT_MODELS=

NWS_USER_AGENT=inland-resilience-agent/0.1 contact@example.com

# Infrastructure
DATABASE_URL=
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Run the worker on recorded fixtures instead of live providers
INLAND_DATA_MODE=fixture
