# Copy to .env and fill in. Never commit .env. Never prefix secrets with VITE_ (Vite ships those to the browser).

# Google Earth Engine (worker)
GEE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gee-service-account.json

# Provider keys (worker)
FIRMS_MAP_KEY=
CIMIS_APP_KEY=
AIRNOW_API_KEY=

# Agent LLM via OpenRouter (free models): your own key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# optional: comma-separated model list, tried in order (defaults live in apps/worker/src/inland_worker/agent/llm.py)
AGENT_MODELS=

NWS_USER_AGENT=inland-resilience-agent/0.1 contact@example.com

# Infrastructure. `make dev` wires these inside Docker; set them only to run the API or worker on the host
# against the compose services (local throwaway credentials, ports bound to 127.0.0.1):
#   DATABASE_URL=postgres://inland:inland@localhost:55432/inland?sslmode=disable
#   REDIS_URL=redis://localhost:56379/0
DATABASE_URL=
REDIS_URL=
ARTIFACTS_DIR=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Job runtime (worker). Defaults shown in infrastructure/docker-compose.yml.
# Fixture mode treats this day as "today" (the recorded FIRMS/NWS data is from 2026-09-19..24)
INLAND_FIXTURE_TODAY=
# reclaim jobs from a crashed worker after this idle time (ms); job wall clock (s)
REAPER_IDLE_MS=
JOB_TIMEOUT_S=

# Run the worker on recorded fixtures instead of live providers
INLAND_DATA_MODE=fixture
